{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://naitv-mcp.dev/schemas/find_hubs.schema.json",
  "title": "find_hubs",
  "type": "object",
  "required": ["modules", "count"],
  "properties": {
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["module", "fan_in"],
        "properties": {
          "module": { "type": "string" },
          "fan_in": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "count": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}
