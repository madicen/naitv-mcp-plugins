{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://naitv-mcp.dev/schemas/search_mistakes.schema.json",
  "title": "search_mistakes",
  "type": "object",
  "required": ["matches", "count", "scores"],
  "properties": {
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "category", "file", "score"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "category": { "type": "string" },
          "file": { "type": "string" },
          "score": { "type": "number" }
        },
        "additionalProperties": false
      }
    },
    "count": { "type": "integer", "minimum": 0 },
    "scores": { "type": "array", "items": { "type": "number" } }
  },
  "additionalProperties": false
}
