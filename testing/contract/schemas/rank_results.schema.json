{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://naitv-mcp.dev/schemas/rank_results.schema.json",
  "title": "rank_results",
  "type": "object",
  "required": ["ranked", "count"],
  "properties": {
    "ranked": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "score", "index"],
        "properties": {
          "path": { "type": "string" },
          "score": { "type": "number", "minimum": 0 },
          "index": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "count": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}
