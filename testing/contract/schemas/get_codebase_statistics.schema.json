{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://naitv-mcp.dev/schemas/get_codebase_statistics.schema.json",
  "title": "get_codebase_statistics",
  "type": "object",
  "required": [
    "total_files",
    "total_lines",
    "complexity",
    "packages",
    "parse_errors",
    "by_language",
    "cached"
  ],
  "properties": {
    "total_files": { "type": "integer", "minimum": 0 },
    "total_lines": { "type": "integer", "minimum": 0 },
    "complexity": { "type": "number", "minimum": 0 },
    "packages": { "type": "integer", "minimum": 0 },
    "parse_errors": { "type": "integer", "minimum": 0 },
    "by_language": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["files", "lines", "complexity"],
        "properties": {
          "files": { "type": "integer", "minimum": 0 },
          "lines": { "type": "integer", "minimum": 0 },
          "complexity": { "type": "number", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "cached": { "type": "boolean" },
    "commit": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
