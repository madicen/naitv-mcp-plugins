{
  "profile": "json_tools",
  "coverage": {
    "module": "change_impact_analyzer",
    "search_paths": [
      "tools/change-impact-analyzer",
      "plugins/change-impact-analyzer"
    ],
    "fail_under": 80
  },
  "layers": {
    "l1": true,
    "l2": true,
    "l3_golden": true,
    "l4": true,
    "l5": true
  },
  "golden": {
    "fixtures": [
      "empty",
      "py-small"
    ],
    "queries": {
      "analyze_change_impact": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "list_affected_tests": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "affected_modules": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "impact_summary": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      }
    }
  },
  "perf": {
    "enabled": false
  },
  "l4": {
    "smoke_args": {
      "root_path": "FIXTURE:empty",
      "query": "Greeter",
      "path": "README.md",
      "limit": 10,
      "depth": 3,
      "pattern": "Greeter",
      "text": "sample"
    },
    "expect_keys": {
      "analyze_change_impact": [
        "ok",
        "tool"
      ],
      "list_affected_tests": [
        "items",
        "count"
      ],
      "affected_modules": [
        "ok",
        "tool"
      ],
      "impact_summary": [
        "items",
        "count"
      ]
    },
    "invalid_tool": "analyze_change_impact",
    "invalid_args": {},
    "post_timeout_tool": "analyze_change_impact",
    "post_timeout_args": {
      "root_path": "FIXTURE:empty",
      "query": "x"
    }
  },
  "l5": {
    "treatment_plugins": [
      "change-impact-analyzer"
    ],
    "tool_names": [
      "analyze_change_impact",
      "list_affected_tests",
      "affected_modules",
      "impact_summary"
    ],
    "gate": {
      "min_success_delta_pp": 10,
      "ci_must_exclude_zero": true,
      "max_control_regression_pp": 2,
      "max_nonexistent_symbol_rate_increase": 0,
      "max_tool_call_inflation_pct": 25
    }
  }
}
