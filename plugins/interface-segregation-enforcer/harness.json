{
  "profile": "json_tools",
  "coverage": {
    "module": "interface_segregation_enforcer",
    "search_paths": [
      "tools/interface-segregation-enforcer",
      "plugins/interface-segregation-enforcer"
    ],
    "fail_under": 80
  },
  "layers": {
    "l1": true,
    "l2": true,
    "l3_golden": true,
    "l4": true,
    "l5": true
  },
  "golden": {
    "fixtures": [
      "empty",
      "py-small"
    ],
    "queries": {
      "list_interfaces": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "find_fat_interfaces": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "suggest_split": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "check_implementations": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      }
    }
  },
  "perf": {
    "enabled": false
  },
  "l4": {
    "smoke_args": {
      "root_path": "FIXTURE:empty",
      "query": "Greeter",
      "path": "README.md",
      "limit": 10,
      "depth": 3,
      "pattern": "Greeter",
      "text": "sample"
    },
    "expect_keys": {
      "list_interfaces": [
        "items",
        "count"
      ],
      "find_fat_interfaces": [
        "items",
        "count"
      ],
      "suggest_split": [
        "generated",
        "ok"
      ],
      "check_implementations": [
        "ok",
        "violations",
        "count"
      ]
    },
    "invalid_tool": "list_interfaces",
    "invalid_args": {},
    "post_timeout_tool": "list_interfaces",
    "post_timeout_args": {
      "root_path": "FIXTURE:empty",
      "query": "x"
    }
  },
  "l5": {
    "treatment_plugins": [
      "interface-segregation-enforcer"
    ],
    "tool_names": [
      "list_interfaces",
      "find_fat_interfaces",
      "suggest_split",
      "check_implementations"
    ],
    "gate": {
      "min_success_delta_pp": 10,
      "ci_must_exclude_zero": true,
      "max_control_regression_pp": 2,
      "max_nonexistent_symbol_rate_increase": 0,
      "max_tool_call_inflation_pct": 25
    }
  }
}
