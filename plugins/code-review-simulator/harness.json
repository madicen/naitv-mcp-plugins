{
  "profile": "json_tools",
  "coverage": {
    "module": "code_review_simulator",
    "search_paths": [
      "tools/code-review-simulator",
      "plugins/code-review-simulator"
    ],
    "fail_under": 80
  },
  "layers": {
    "l1": true,
    "l2": true,
    "l3_golden": true,
    "l4": true,
    "l5": true
  },
  "golden": {
    "fixtures": [
      "empty",
      "py-small"
    ],
    "queries": {
      "review_diff": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "score_risk": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "list_reviewer_questions": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "suggest_tests": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      }
    }
  },
  "perf": {
    "enabled": false
  },
  "l4": {
    "smoke_args": {
      "root_path": "FIXTURE:empty",
      "query": "Greeter",
      "path": "README.md",
      "limit": 10,
      "depth": 3,
      "pattern": "Greeter",
      "text": "sample"
    },
    "expect_keys": {
      "review_diff": [
        "ok",
        "tool"
      ],
      "score_risk": [
        "ok",
        "tool"
      ],
      "list_reviewer_questions": [
        "items",
        "count"
      ],
      "suggest_tests": [
        "generated",
        "ok"
      ]
    },
    "invalid_tool": "review_diff",
    "invalid_args": {},
    "post_timeout_tool": "review_diff",
    "post_timeout_args": {
      "root_path": "FIXTURE:empty",
      "query": "x"
    }
  },
  "l5": {
    "treatment_plugins": [
      "code-review-simulator"
    ],
    "tool_names": [
      "review_diff",
      "score_risk",
      "list_reviewer_questions",
      "suggest_tests"
    ],
    "gate": {
      "min_success_delta_pp": 10,
      "ci_must_exclude_zero": true,
      "max_control_regression_pp": 2,
      "max_nonexistent_symbol_rate_increase": 0,
      "max_tool_call_inflation_pct": 25
    },
    "model": {
      "name": "qwen3:8b",
      "provider": "ollama",
      "quantization": "default",
      "context": 8192,
      "temperature": 0,
      "seed": 0
    }
  }
}
