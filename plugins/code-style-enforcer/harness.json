{
  "profile": "json_tools",
  "coverage": {
    "module": "code_style_enforcer",
    "search_paths": [
      "tools/code-style-enforcer",
      "plugins/code-style-enforcer"
    ],
    "fail_under": 80
  },
  "layers": {
    "l1": true,
    "l2": true,
    "l3_golden": true,
    "l4": true,
    "l5": true
  },
  "golden": {
    "fixtures": [
      "empty",
      "py-small"
    ],
    "queries": {
      "check_style": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "load_style_rules": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "suggest_fixes": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "style_summary": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      }
    }
  },
  "perf": {
    "enabled": false
  },
  "l4": {
    "smoke_args": {
      "root_path": "FIXTURE:empty",
      "query": "Greeter",
      "path": "README.md",
      "limit": 10,
      "depth": 3,
      "pattern": "Greeter",
      "text": "sample"
    },
    "expect_keys": {
      "check_style": [
        "ok",
        "violations",
        "count"
      ],
      "load_style_rules": [
        "loaded",
        "content"
      ],
      "suggest_fixes": [
        "generated",
        "ok"
      ],
      "style_summary": [
        "items",
        "count"
      ]
    },
    "invalid_tool": "check_style",
    "invalid_args": {},
    "post_timeout_tool": "check_style",
    "post_timeout_args": {
      "root_path": "FIXTURE:empty",
      "query": "x"
    }
  },
  "l5": {
    "treatment_plugins": [
      "code-style-enforcer"
    ],
    "tool_names": [
      "check_style",
      "load_style_rules",
      "suggest_fixes",
      "style_summary"
    ],
    "gate": {
      "min_success_delta_pp": 10,
      "ci_must_exclude_zero": true,
      "max_control_regression_pp": 2,
      "max_nonexistent_symbol_rate_increase": 0,
      "max_tool_call_inflation_pct": 25
    },
    "model": {
      "name": "qwen3:8b",
      "provider": "ollama",
      "quantization": "default",
      "context": 8192,
      "temperature": 0,
      "seed": 0
    }
  }
}
