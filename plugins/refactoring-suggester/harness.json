{
  "profile": "json_tools",
  "coverage": {
    "module": "refactoring_suggester",
    "search_paths": [
      "tools/refactoring-suggester",
      "plugins/refactoring-suggester"
    ],
    "fail_under": 80
  },
  "layers": {
    "l1": true,
    "l2": true,
    "l3_golden": true,
    "l4": true,
    "l5": true
  },
  "golden": {
    "fixtures": [
      "empty",
      "py-small"
    ],
    "queries": {
      "analyze_complexity": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "find_duplicates": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "suggest_extract_method": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "suggest_rename": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "rank_refactorings": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      }
    }
  },
  "perf": {
    "enabled": false
  },
  "l4": {
    "smoke_args": {
      "root_path": "FIXTURE:empty",
      "query": "Greeter",
      "path": "README.md",
      "limit": 10,
      "depth": 3,
      "pattern": "Greeter",
      "text": "sample"
    },
    "expect_keys": {
      "analyze_complexity": [
        "ok",
        "tool"
      ],
      "find_duplicates": [
        "items",
        "count"
      ],
      "suggest_extract_method": [
        "generated",
        "ok"
      ],
      "suggest_rename": [
        "generated",
        "ok"
      ],
      "rank_refactorings": [
        "ok",
        "tool"
      ]
    },
    "invalid_tool": "analyze_complexity",
    "invalid_args": {},
    "post_timeout_tool": "analyze_complexity",
    "post_timeout_args": {
      "root_path": "FIXTURE:empty",
      "query": "x"
    }
  },
  "l5": {
    "treatment_plugins": [
      "refactoring-suggester"
    ],
    "tool_names": [
      "analyze_complexity",
      "find_duplicates",
      "suggest_extract_method",
      "suggest_rename",
      "rank_refactorings"
    ],
    "gate": {
      "min_success_delta_pp": 10,
      "ci_must_exclude_zero": true,
      "max_control_regression_pp": 2,
      "max_nonexistent_symbol_rate_increase": 0,
      "max_tool_call_inflation_pct": 25
    },
    "model": {
      "name": "qwen3:8b",
      "provider": "ollama",
      "quantization": "default",
      "context": 8192,
      "temperature": 0,
      "seed": 0
    }
  }
}
