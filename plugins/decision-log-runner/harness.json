{
  "profile": "json_tools",
  "coverage": {
    "module": "decision_log_runner",
    "search_paths": [
      "tools/decision-log-runner",
      "plugins/decision-log-runner"
    ],
    "fail_under": 80
  },
  "layers": {
    "l1": true,
    "l2": true,
    "l3_golden": true,
    "l4": true,
    "l5": true
  },
  "golden": {
    "fixtures": [
      "empty",
      "py-small"
    ],
    "queries": {
      "parse_decision_log": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "search_decisions": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "check_decision_conflicts": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "summarize_decisions": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      }
    }
  },
  "perf": {
    "enabled": false
  },
  "l4": {
    "smoke_args": {
      "root_path": "FIXTURE:empty",
      "query": "Greeter",
      "path": "README.md",
      "limit": 10,
      "depth": 3,
      "pattern": "Greeter",
      "text": "sample"
    },
    "expect_keys": {
      "parse_decision_log": [
        "loaded",
        "content"
      ],
      "search_decisions": [
        "items",
        "count"
      ],
      "check_decision_conflicts": [
        "ok",
        "violations",
        "count"
      ],
      "summarize_decisions": [
        "ok",
        "tool"
      ]
    },
    "invalid_tool": "parse_decision_log",
    "invalid_args": {},
    "post_timeout_tool": "parse_decision_log",
    "post_timeout_args": {
      "root_path": "FIXTURE:empty",
      "query": "x"
    }
  },
  "l5": {
    "treatment_plugins": [
      "decision-log-runner"
    ],
    "tool_names": [
      "parse_decision_log",
      "search_decisions",
      "check_decision_conflicts",
      "summarize_decisions"
    ],
    "gate": {
      "min_success_delta_pp": 10,
      "ci_must_exclude_zero": true,
      "max_control_regression_pp": 2,
      "max_nonexistent_symbol_rate_increase": 0,
      "max_tool_call_inflation_pct": 25
    }
  }
}
