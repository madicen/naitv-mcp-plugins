{
  "profile": "json_tools",
  "coverage": {
    "module": "symbol_navigator",
    "search_paths": [
      "tools/symbol-navigator",
      "plugins/symbol-navigator"
    ],
    "fail_under": 80
  },
  "layers": {
    "l1": true,
    "l2": true,
    "l3_golden": true,
    "l4": true,
    "l5": true
  },
  "golden": {
    "fixtures": [
      "py-small",
      "go-small",
      "empty",
      "mixed-polyglot",
      "hostile"
    ],
    "queries": {
      "find_symbol_definition": {
        "symbol": "Greeter",
        "depth": 3
      },
      "search_by_pattern": {
        "pattern": "Greet|Add|add",
        "depth": 3
      },
      "get_symbol_references": {
        "symbol": "Greeter",
        "depth": 3
      }
    }
  },
  "perf": {
    "enabled": true,
    "tool": "find_symbol_definition",
    "module": "symbol_navigator",
    "cache_subdir": "symbol-navigator",
    "call": "find_symbol_definition",
    "call_args": [
      "PerfAnchor"
    ],
    "targets_seconds": {
      "warm": 0.1,
      "cold": 30.0,
      "cold_start": 60.0
    }
  },
  "l4": {
    "smoke_args": {
      "root_path": "FIXTURE:py-small",
      "depth": 3,
      "symbol": "Greeter",
      "pattern": "^Greet"
    },
    "expect_keys": {
      "find_symbol_definition": [
        "cached"
      ],
      "search_by_pattern": [
        "results",
        "cached"
      ],
      "get_symbol_references": [
        "references",
        "heuristic",
        "cached"
      ]
    },
    "invalid_tool": "find_symbol_definition",
    "invalid_args": {
      "depth": 1
    },
    "post_timeout_tool": "search_by_pattern",
    "post_timeout_args": {
      "root_path": "FIXTURE:empty",
      "depth": 1,
      "pattern": "^Nope"
    }
  },
  "l5": {
    "treatment_plugins": [
      "symbol-navigator"
    ],
    "tool_names": [
      "find_symbol_definition",
      "search_by_pattern",
      "get_symbol_references"
    ],
    "gate": {
      "min_success_delta_pp": 10,
      "ci_must_exclude_zero": true,
      "max_control_regression_pp": 2,
      "max_nonexistent_symbol_rate_increase": 0,
      "max_tool_call_inflation_pct": 25
    },
    "model": {
      "name": "qwen3:8b",
      "provider": "ollama",
      "quantization": "default",
      "context": 8192,
      "temperature": 0,
      "seed": 0
    }
  }
}
