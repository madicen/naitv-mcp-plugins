{
  "profile": "json_tools",
  "coverage": {
    "module": "symbol_navigator",
    "search_paths": ["tools/symbol-navigator", "plugins/symbol-navigator"],
    "fail_under": 80
  },
  "layers": {
    "l1": true,
    "l2": true,
    "l3_golden": false,
    "l4": true,
    "l5": false
  },
  "perf": {
    "enabled": false
  },
  "l4": {
    "smoke_args": {
      "root_path": "FIXTURE:py-small",
      "depth": 3,
      "symbol": "Greeter",
      "pattern": "^Greet"
    },
    "expect_keys": {
      "find_symbol_definition": ["cached"],
      "search_by_pattern": ["results", "cached"],
      "get_symbol_references": ["references", "heuristic", "cached"]
    },
    "invalid_tool": "find_symbol_definition",
    "invalid_args": { "depth": 1 },
    "post_timeout_tool": "search_by_pattern",
    "post_timeout_args": {
      "root_path": "FIXTURE:empty",
      "depth": 1,
      "pattern": "^Nope"
    }
  },
  "l5": {
    "treatment_plugins": ["symbol-navigator"],
    "tool_names": [
      "find_symbol_definition",
      "search_by_pattern",
      "get_symbol_references"
    ]
  }
}
