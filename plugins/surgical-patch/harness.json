{
  "profile": "json_tools",
  "coverage": {
    "module": "surgical_patch",
    "search_paths": [
      "tools/surgical-patch",
      "plugins/surgical-patch"
    ],
    "fail_under": 80
  },
  "layers": {
    "l1": true,
    "l2": true,
    "l3_golden": true,
    "l4": true,
    "l5": true
  },
  "golden": {
    "fixtures": [
      "empty",
      "py-small"
    ],
    "queries": {
      "generate_minimal_diff": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "validate_patch_scope": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "apply_patch_dry_run": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      }
    }
  },
  "perf": {
    "enabled": false
  },
  "l4": {
    "smoke_args": {
      "root_path": "FIXTURE:empty",
      "query": "Greeter",
      "path": "README.md",
      "limit": 10,
      "depth": 3,
      "pattern": "Greeter",
      "text": "sample"
    },
    "expect_keys": {
      "generate_minimal_diff": [
        "generated",
        "ok"
      ],
      "validate_patch_scope": [
        "ok",
        "violations",
        "count"
      ],
      "apply_patch_dry_run": [
        "ok",
        "exit_code",
        "summary"
      ]
    },
    "invalid_tool": "generate_minimal_diff",
    "invalid_args": {},
    "post_timeout_tool": "generate_minimal_diff",
    "post_timeout_args": {
      "root_path": "FIXTURE:empty",
      "query": "x"
    }
  },
  "l5": {
    "treatment_plugins": [
      "surgical-patch"
    ],
    "tool_names": [
      "generate_minimal_diff",
      "validate_patch_scope",
      "apply_patch_dry_run"
    ],
    "gate": {
      "min_success_delta_pp": 10,
      "ci_must_exclude_zero": true,
      "max_control_regression_pp": 2,
      "max_nonexistent_symbol_rate_increase": 0,
      "max_tool_call_inflation_pct": 25
    }
  }
}
