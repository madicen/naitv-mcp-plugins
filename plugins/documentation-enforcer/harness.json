{
  "profile": "json_tools",
  "coverage": {
    "module": "documentation_enforcer",
    "search_paths": [
      "tools/documentation-enforcer",
      "plugins/documentation-enforcer"
    ],
    "fail_under": 80
  },
  "layers": {
    "l1": true,
    "l2": true,
    "l3_golden": true,
    "l4": true,
    "l5": true
  },
  "golden": {
    "fixtures": [
      "empty",
      "py-small"
    ],
    "queries": {
      "find_undocumented": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "check_doc_comments": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "generate_doc_stub": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "doc_coverage_report": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      }
    }
  },
  "perf": {
    "enabled": false
  },
  "l4": {
    "smoke_args": {
      "root_path": "FIXTURE:empty",
      "query": "Greeter",
      "path": "README.md",
      "limit": 10,
      "depth": 3,
      "pattern": "Greeter",
      "text": "sample"
    },
    "expect_keys": {
      "find_undocumented": [
        "items",
        "count"
      ],
      "check_doc_comments": [
        "ok",
        "violations",
        "count"
      ],
      "generate_doc_stub": [
        "generated",
        "ok"
      ],
      "doc_coverage_report": [
        "items",
        "count"
      ]
    },
    "invalid_tool": "find_undocumented",
    "invalid_args": {},
    "post_timeout_tool": "find_undocumented",
    "post_timeout_args": {
      "root_path": "FIXTURE:empty",
      "query": "x"
    }
  },
  "l5": {
    "treatment_plugins": [
      "documentation-enforcer"
    ],
    "tool_names": [
      "find_undocumented",
      "check_doc_comments",
      "generate_doc_stub",
      "doc_coverage_report"
    ],
    "gate": {
      "min_success_delta_pp": 10,
      "ci_must_exclude_zero": true,
      "max_control_regression_pp": 2,
      "max_nonexistent_symbol_rate_increase": 0,
      "max_tool_call_inflation_pct": 25
    }
  }
}
