{
  "profile": "json_tools",
  "coverage": {
    "module": "specification_enforcer",
    "search_paths": [
      "tools/specification-enforcer",
      "plugins/specification-enforcer"
    ],
    "fail_under": 80
  },
  "layers": {
    "l1": true,
    "l2": true,
    "l3_golden": true,
    "l4": true,
    "l5": true
  },
  "golden": {
    "fixtures": [
      "empty",
      "py-small"
    ],
    "queries": {
      "load_spec": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "extract_requirements": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "check_coverage": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "report_violations": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      }
    }
  },
  "perf": {
    "enabled": false
  },
  "l4": {
    "smoke_args": {
      "root_path": "FIXTURE:empty",
      "query": "Greeter",
      "path": "README.md",
      "limit": 10,
      "depth": 3,
      "pattern": "Greeter",
      "text": "sample"
    },
    "expect_keys": {
      "load_spec": [
        "loaded",
        "content"
      ],
      "extract_requirements": [
        "items",
        "count"
      ],
      "check_coverage": [
        "ok",
        "violations",
        "count"
      ],
      "report_violations": [
        "ok",
        "tool"
      ]
    },
    "invalid_tool": "load_spec",
    "invalid_args": {},
    "post_timeout_tool": "load_spec",
    "post_timeout_args": {
      "root_path": "FIXTURE:empty",
      "query": "x"
    }
  },
  "l5": {
    "treatment_plugins": [
      "specification-enforcer"
    ],
    "tool_names": [
      "load_spec",
      "extract_requirements",
      "check_coverage",
      "report_violations"
    ],
    "gate": {
      "min_success_delta_pp": 10,
      "ci_must_exclude_zero": true,
      "max_control_regression_pp": 2,
      "max_nonexistent_symbol_rate_increase": 0,
      "max_tool_call_inflation_pct": 25
    }
  }
}
