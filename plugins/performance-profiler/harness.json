{
  "profile": "json_tools",
  "coverage": {
    "module": "performance_profiler",
    "search_paths": [
      "tools/performance-profiler",
      "plugins/performance-profiler"
    ],
    "fail_under": 80
  },
  "layers": {
    "l1": true,
    "l2": true,
    "l3_golden": true,
    "l4": true,
    "l5": true
  },
  "golden": {
    "fixtures": [
      "empty",
      "py-small"
    ],
    "queries": {
      "run_benchmark": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "profile_hotspots": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "compare_profiles": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "summarize_profile": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      }
    }
  },
  "perf": {
    "enabled": false
  },
  "l4": {
    "smoke_args": {
      "root_path": "FIXTURE:empty",
      "query": "Greeter",
      "path": "README.md",
      "limit": 10,
      "depth": 3,
      "pattern": "Greeter",
      "text": "sample"
    },
    "expect_keys": {
      "run_benchmark": [
        "ok",
        "exit_code",
        "summary"
      ],
      "profile_hotspots": [
        "ok",
        "tool"
      ],
      "compare_profiles": [
        "ok",
        "tool"
      ],
      "summarize_profile": [
        "ok",
        "tool"
      ]
    },
    "invalid_tool": "run_benchmark",
    "invalid_args": {},
    "post_timeout_tool": "run_benchmark",
    "post_timeout_args": {
      "root_path": "FIXTURE:empty",
      "query": "x"
    }
  },
  "l5": {
    "treatment_plugins": [
      "performance-profiler"
    ],
    "tool_names": [
      "run_benchmark",
      "profile_hotspots",
      "compare_profiles",
      "summarize_profile"
    ],
    "gate": {
      "min_success_delta_pp": 10,
      "ci_must_exclude_zero": true,
      "max_control_regression_pp": 2,
      "max_nonexistent_symbol_rate_increase": 0,
      "max_tool_call_inflation_pct": 25
    },
    "model": {
      "name": "qwen3:8b",
      "provider": "ollama",
      "quantization": "default",
      "context": 8192,
      "temperature": 0,
      "seed": 0
    }
  }
}
