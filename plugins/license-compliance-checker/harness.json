{
  "profile": "json_tools",
  "coverage": {
    "module": "license_compliance_checker",
    "search_paths": [
      "tools/license-compliance-checker",
      "plugins/license-compliance-checker"
    ],
    "fail_under": 80
  },
  "layers": {
    "l1": true,
    "l2": true,
    "l3_golden": true,
    "l4": true,
    "l5": true
  },
  "golden": {
    "fixtures": [
      "empty",
      "py-small"
    ],
    "queries": {
      "list_dependency_licenses": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "check_license_policy": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "find_license_conflicts": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "license_summary": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      }
    }
  },
  "perf": {
    "enabled": false
  },
  "l4": {
    "smoke_args": {
      "root_path": "FIXTURE:empty",
      "query": "Greeter",
      "path": "README.md",
      "limit": 10,
      "depth": 3,
      "pattern": "Greeter",
      "text": "sample"
    },
    "expect_keys": {
      "list_dependency_licenses": [
        "items",
        "count"
      ],
      "check_license_policy": [
        "ok",
        "violations",
        "count"
      ],
      "find_license_conflicts": [
        "items",
        "count"
      ],
      "license_summary": [
        "items",
        "count"
      ]
    },
    "invalid_tool": "list_dependency_licenses",
    "invalid_args": {},
    "post_timeout_tool": "list_dependency_licenses",
    "post_timeout_args": {
      "root_path": "FIXTURE:empty",
      "query": "x"
    }
  },
  "l5": {
    "treatment_plugins": [
      "license-compliance-checker"
    ],
    "tool_names": [
      "list_dependency_licenses",
      "check_license_policy",
      "find_license_conflicts",
      "license_summary"
    ],
    "gate": {
      "min_success_delta_pp": 10,
      "ci_must_exclude_zero": true,
      "max_control_regression_pp": 2,
      "max_nonexistent_symbol_rate_increase": 0,
      "max_tool_call_inflation_pct": 25
    }
  }
}
