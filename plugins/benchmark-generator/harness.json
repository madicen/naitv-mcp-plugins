{
  "profile": "json_tools",
  "coverage": {
    "module": "benchmark_generator",
    "search_paths": [
      "tools/benchmark-generator",
      "plugins/benchmark-generator"
    ],
    "fail_under": 80
  },
  "layers": {
    "l1": true,
    "l2": true,
    "l3_golden": true,
    "l4": true,
    "l5": true
  },
  "golden": {
    "fixtures": [
      "empty",
      "py-small"
    ],
    "queries": {
      "find_bench_targets": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "generate_benchmark": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "validate_benchmark": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "run_benchmark_once": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "list_benchmarks": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      }
    }
  },
  "perf": {
    "enabled": false
  },
  "l4": {
    "smoke_args": {
      "root_path": "FIXTURE:empty",
      "query": "Greeter",
      "path": "README.md",
      "limit": 10,
      "depth": 3,
      "pattern": "Greeter",
      "text": "sample"
    },
    "expect_keys": {
      "find_bench_targets": [
        "items",
        "count"
      ],
      "generate_benchmark": [
        "generated",
        "ok"
      ],
      "validate_benchmark": [
        "ok",
        "violations",
        "count"
      ],
      "run_benchmark_once": [
        "ok",
        "exit_code",
        "summary"
      ],
      "list_benchmarks": [
        "items",
        "count"
      ]
    },
    "invalid_tool": "find_bench_targets",
    "invalid_args": {},
    "post_timeout_tool": "find_bench_targets",
    "post_timeout_args": {
      "root_path": "FIXTURE:empty",
      "query": "x"
    }
  },
  "l5": {
    "treatment_plugins": [
      "benchmark-generator"
    ],
    "tool_names": [
      "find_bench_targets",
      "generate_benchmark",
      "validate_benchmark",
      "run_benchmark_once",
      "list_benchmarks"
    ],
    "gate": {
      "min_success_delta_pp": 10,
      "ci_must_exclude_zero": true,
      "max_control_regression_pp": 2,
      "max_nonexistent_symbol_rate_increase": 0,
      "max_tool_call_inflation_pct": 25
    },
    "model": {
      "name": "qwen3:8b",
      "provider": "ollama",
      "quantization": "default",
      "context": 8192,
      "temperature": 0,
      "seed": 0
    }
  }
}
