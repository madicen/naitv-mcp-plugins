{
  "profile": "json_tools",
  "coverage": {
    "module": "secrets_detector",
    "search_paths": [
      "tools/secrets-detector",
      "plugins/secrets-detector"
    ],
    "fail_under": 80
  },
  "layers": {
    "l1": true,
    "l2": true,
    "l3_golden": true,
    "l4": true,
    "l5": true
  },
  "golden": {
    "fixtures": [
      "empty",
      "py-small"
    ],
    "queries": {
      "scan_secrets": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "scan_secrets_file": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "list_patterns": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "allowlist_check": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      }
    }
  },
  "perf": {
    "enabled": false
  },
  "l4": {
    "smoke_args": {
      "root_path": "FIXTURE:empty",
      "query": "Greeter",
      "path": "README.md",
      "limit": 10,
      "depth": 3,
      "pattern": "Greeter",
      "text": "sample"
    },
    "expect_keys": {
      "scan_secrets": [
        "items",
        "count"
      ],
      "scan_secrets_file": [
        "items",
        "count"
      ],
      "list_patterns": [
        "items",
        "count"
      ],
      "allowlist_check": [
        "ok",
        "violations",
        "count"
      ]
    },
    "invalid_tool": "scan_secrets",
    "invalid_args": {},
    "post_timeout_tool": "scan_secrets",
    "post_timeout_args": {
      "root_path": "FIXTURE:empty",
      "query": "x"
    }
  },
  "l5": {
    "treatment_plugins": [
      "secrets-detector"
    ],
    "tool_names": [
      "scan_secrets",
      "scan_secrets_file",
      "list_patterns",
      "allowlist_check"
    ],
    "gate": {
      "min_success_delta_pp": 10,
      "ci_must_exclude_zero": true,
      "max_control_regression_pp": 2,
      "max_nonexistent_symbol_rate_increase": 0,
      "max_tool_call_inflation_pct": 25
    },
    "model": {
      "name": "qwen3:8b",
      "provider": "ollama",
      "quantization": "default",
      "context": 8192,
      "temperature": 0,
      "seed": 0
    }
  }
}
