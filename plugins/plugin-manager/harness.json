{
  "profile": "json_tools",
  "coverage": {
    "module": "plugin_manager",
    "search_paths": ["tools/plugin-manager", "plugins/plugin-manager"],
    "fail_under": 80
  },
  "layers": {
    "l1": true,
    "l2": true,
    "l3_golden": true,
    "l4": true,
    "l5": false
  },
  "golden": {
    "fixtures": ["plugins-mini", "empty", "hostile"],
    "queries": {
      "list_plugins": {},
      "validate_plugin": { "plugin": "sample" },
      "test_plugin": { "plugin": "sample", "layers": "lint" }
    }
  },
  "perf": {
    "enabled": false
  },
  "l4": {
    "smoke_args": {
      "root_path": "FIXTURE:plugins-mini",
      "plugin": "sample",
      "layers": "lint"
    },
    "expect_keys": {
      "list_plugins": ["plugins", "count"],
      "validate_plugin": ["ok", "plugin", "errors"],
      "test_plugin": ["ok", "plugin", "layers", "errors"]
    },
    "invalid_tool": "validate_plugin",
    "invalid_args": { "plugin": "sample" },
    "post_timeout_tool": "list_plugins",
    "post_timeout_args": {
      "root_path": "FIXTURE:empty"
    }
  },
  "l5": {
    "treatment_plugins": ["plugin-manager"],
    "tool_names": ["list_plugins", "validate_plugin", "test_plugin"]
  }
}
