{
  "profile": "json_tools",
  "coverage": {
    "module": "rollback_plan_generator",
    "search_paths": [
      "tools/rollback-plan-generator",
      "plugins/rollback-plan-generator"
    ],
    "fail_under": 80
  },
  "layers": {
    "l1": true,
    "l2": true,
    "l3_golden": true,
    "l4": true,
    "l5": true
  },
  "golden": {
    "fixtures": [
      "empty",
      "py-small"
    ],
    "queries": {
      "analyze_change_risk": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "generate_rollback_steps": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "list_affected_services": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "validate_rollback_plan": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      }
    }
  },
  "perf": {
    "enabled": false
  },
  "l4": {
    "smoke_args": {
      "root_path": "FIXTURE:empty",
      "query": "Greeter",
      "path": "README.md",
      "limit": 10,
      "depth": 3,
      "pattern": "Greeter",
      "text": "sample"
    },
    "expect_keys": {
      "analyze_change_risk": [
        "ok",
        "tool"
      ],
      "generate_rollback_steps": [
        "generated",
        "ok"
      ],
      "list_affected_services": [
        "items",
        "count"
      ],
      "validate_rollback_plan": [
        "ok",
        "violations",
        "count"
      ]
    },
    "invalid_tool": "analyze_change_risk",
    "invalid_args": {},
    "post_timeout_tool": "analyze_change_risk",
    "post_timeout_args": {
      "root_path": "FIXTURE:empty",
      "query": "x"
    }
  },
  "l5": {
    "treatment_plugins": [
      "rollback-plan-generator"
    ],
    "tool_names": [
      "analyze_change_risk",
      "generate_rollback_steps",
      "list_affected_services",
      "validate_rollback_plan"
    ],
    "gate": {
      "min_success_delta_pp": 10,
      "ci_must_exclude_zero": true,
      "max_control_regression_pp": 2,
      "max_nonexistent_symbol_rate_increase": 0,
      "max_tool_call_inflation_pct": 25
    }
  }
}
