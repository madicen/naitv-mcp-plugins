{
  "profile": "json_tools",
  "coverage": {
    "module": "lint_fix_loop",
    "search_paths": [
      "tools/lint-fix-loop",
      "plugins/lint-fix-loop"
    ],
    "fail_under": 80
  },
  "layers": {
    "l1": true,
    "l2": true,
    "l3_golden": true,
    "l4": true,
    "l5": true
  },
  "golden": {
    "fixtures": [
      "empty",
      "py-small"
    ],
    "queries": {
      "run_linter": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "apply_safe_fixes": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "summarize_lint_results": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      }
    }
  },
  "perf": {
    "enabled": false
  },
  "l4": {
    "smoke_args": {
      "root_path": "FIXTURE:empty",
      "query": "Greeter",
      "path": "README.md",
      "limit": 10,
      "depth": 3,
      "pattern": "Greeter",
      "text": "sample"
    },
    "expect_keys": {
      "run_linter": [
        "ok",
        "exit_code",
        "summary"
      ],
      "apply_safe_fixes": [
        "ok",
        "exit_code",
        "summary"
      ],
      "summarize_lint_results": [
        "ok",
        "tool"
      ]
    },
    "invalid_tool": "run_linter",
    "invalid_args": {},
    "post_timeout_tool": "run_linter",
    "post_timeout_args": {
      "root_path": "FIXTURE:empty",
      "query": "x"
    }
  },
  "l5": {
    "treatment_plugins": [
      "lint-fix-loop"
    ],
    "tool_names": [
      "run_linter",
      "apply_safe_fixes",
      "summarize_lint_results"
    ],
    "gate": {
      "min_success_delta_pp": 10,
      "ci_must_exclude_zero": true,
      "max_control_regression_pp": 2,
      "max_nonexistent_symbol_rate_increase": 0,
      "max_tool_call_inflation_pct": 25
    }
  }
}
