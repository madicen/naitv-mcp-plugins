{
  "profile": "json_tools",
  "coverage": {
    "module": "incremental_refactoring_helper",
    "search_paths": [
      "tools/incremental-refactoring-helper",
      "plugins/incremental-refactoring-helper"
    ],
    "fail_under": 80
  },
  "layers": {
    "l1": true,
    "l2": true,
    "l3_golden": true,
    "l4": true,
    "l5": true
  },
  "golden": {
    "fixtures": [
      "empty",
      "py-small"
    ],
    "queries": {
      "plan_refactor_steps": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "next_step": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "track_refactor_state": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "mark_step_done": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      }
    }
  },
  "perf": {
    "enabled": false
  },
  "l4": {
    "smoke_args": {
      "root_path": "FIXTURE:empty",
      "query": "Greeter",
      "path": "README.md",
      "limit": 10,
      "depth": 3,
      "pattern": "Greeter",
      "text": "sample"
    },
    "expect_keys": {
      "plan_refactor_steps": [
        "generated",
        "ok"
      ],
      "next_step": [
        "ok",
        "tool"
      ],
      "track_refactor_state": [
        "stored",
        "id"
      ],
      "mark_step_done": [
        "stored",
        "id"
      ]
    },
    "invalid_tool": "plan_refactor_steps",
    "invalid_args": {},
    "post_timeout_tool": "plan_refactor_steps",
    "post_timeout_args": {
      "root_path": "FIXTURE:empty",
      "query": "x"
    }
  },
  "l5": {
    "treatment_plugins": [
      "incremental-refactoring-helper"
    ],
    "tool_names": [
      "plan_refactor_steps",
      "next_step",
      "track_refactor_state",
      "mark_step_done"
    ],
    "gate": {
      "min_success_delta_pp": 10,
      "ci_must_exclude_zero": true,
      "max_control_regression_pp": 2,
      "max_nonexistent_symbol_rate_increase": 0,
      "max_tool_call_inflation_pct": 25
    },
    "model": {
      "name": "qwen3:8b",
      "provider": "ollama",
      "quantization": "default",
      "context": 8192,
      "temperature": 0,
      "seed": 0
    }
  }
}
