{
  "profile": "json_tools",
  "coverage": {
    "module": "dependency_graph_analyzer",
    "search_paths": ["tools/dependency-graph-analyzer", "plugins/dependency-graph-analyzer"],
    "fail_under": 80
  },
  "layers": {
    "l1": true,
    "l2": true,
    "l3_golden": true,
    "l4": true,
    "l5": true
  },
  "golden": {
    "fixtures": ["deps-mini", "empty", "go-small"],
    "queries": {
      "build_import_graph": { "language": "auto", "depth": 3 },
      "query_dependencies": { "module": "mod_a", "depth": 3 },
      "find_hubs": { "limit": 5, "depth": 3 },
      "export_graph": { "format": "dot", "depth": 3 }
    }
  },
  "perf": { "enabled": false },
  "l4": {
    "smoke_args": {
      "root_path": "FIXTURE:deps-mini",
      "language": "python",
      "module": "mod_a",
      "limit": 5,
      "format": "dot",
      "depth": 3
    },
    "expect_keys": {
      "build_import_graph": ["nodes", "edges", "node_count"],
      "query_dependencies": ["module", "imports", "imported_by"],
      "find_hubs": ["modules", "count"],
      "export_graph": ["format", "graph"]
    },
    "invalid_tool": "build_import_graph",
    "invalid_args": {},
    "post_timeout_tool": "find_hubs",
    "post_timeout_args": {
      "root_path": "FIXTURE:empty",
      "limit": 3
    }
  },
  "l5": {
    "treatment_plugins": ["dependency-graph-analyzer"],
    "tool_names": [
      "build_import_graph",
      "query_dependencies",
      "find_hubs",
      "export_graph"
    ],
    "gate": {
      "min_success_delta_pp": 10,
      "ci_must_exclude_zero": true,
      "max_control_regression_pp": 2,
      "max_nonexistent_symbol_rate_increase": 0,
      "max_tool_call_inflation_pct": 25
    }
  }
}
