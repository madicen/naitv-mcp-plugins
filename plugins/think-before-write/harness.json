{
  "profile": "json_tools",
  "coverage": {
    "module": "think_before_write",
    "search_paths": [
      "tools/think-before-write",
      "plugins/think-before-write"
    ],
    "fail_under": 80
  },
  "layers": {
    "l1": true,
    "l2": true,
    "l3_golden": true,
    "l4": true,
    "l5": true
  },
  "golden": {
    "fixtures": [
      "empty",
      "py-small"
    ],
    "queries": {
      "plan_checklist": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "check_assumptions": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "render_pre_write_prompt": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      }
    }
  },
  "perf": {
    "enabled": false
  },
  "l4": {
    "smoke_args": {
      "root_path": "FIXTURE:empty",
      "query": "Greeter",
      "path": "README.md",
      "limit": 10,
      "depth": 3,
      "pattern": "Greeter",
      "text": "sample"
    },
    "expect_keys": {
      "plan_checklist": [
        "generated",
        "ok"
      ],
      "check_assumptions": [
        "ok",
        "violations",
        "count"
      ],
      "render_pre_write_prompt": [
        "generated",
        "ok"
      ]
    },
    "invalid_tool": "plan_checklist",
    "invalid_args": {},
    "post_timeout_tool": "plan_checklist",
    "post_timeout_args": {
      "root_path": "FIXTURE:empty",
      "query": "x"
    }
  },
  "l5": {
    "treatment_plugins": [
      "think-before-write"
    ],
    "tool_names": [
      "plan_checklist",
      "check_assumptions",
      "render_pre_write_prompt"
    ],
    "gate": {
      "min_success_delta_pp": 10,
      "ci_must_exclude_zero": true,
      "max_control_regression_pp": 2,
      "max_nonexistent_symbol_rate_increase": 0,
      "max_tool_call_inflation_pct": 25
    },
    "model": {
      "name": "qwen3:8b",
      "provider": "ollama",
      "quantization": "default",
      "context": 8192,
      "temperature": 0,
      "seed": 0
    }
  }
}
