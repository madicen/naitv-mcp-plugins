{
  "profile": "json_tools",
  "coverage": {
    "module": "tdd_runner",
    "search_paths": [
      "tools/tdd-runner",
      "plugins/tdd-runner"
    ],
    "fail_under": 80
  },
  "layers": {
    "l1": true,
    "l2": true,
    "l3_golden": true,
    "l4": true,
    "l5": true
  },
  "golden": {
    "fixtures": [
      "empty",
      "py-small"
    ],
    "queries": {
      "run_tests": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "failing_test_summary": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "select_tests_for_change": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      }
    }
  },
  "perf": {
    "enabled": false
  },
  "l4": {
    "smoke_args": {
      "root_path": "FIXTURE:empty",
      "query": "Greeter",
      "path": "README.md",
      "limit": 10,
      "depth": 3,
      "pattern": "Greeter",
      "text": "sample"
    },
    "expect_keys": {
      "run_tests": [
        "ok",
        "exit_code",
        "summary"
      ],
      "failing_test_summary": [
        "items",
        "count"
      ],
      "select_tests_for_change": [
        "ok",
        "tool"
      ]
    },
    "invalid_tool": "run_tests",
    "invalid_args": {},
    "post_timeout_tool": "run_tests",
    "post_timeout_args": {
      "root_path": "FIXTURE:empty",
      "query": "x"
    }
  },
  "l5": {
    "treatment_plugins": [
      "tdd-runner"
    ],
    "tool_names": [
      "run_tests",
      "failing_test_summary",
      "select_tests_for_change"
    ],
    "gate": {
      "min_success_delta_pp": 10,
      "ci_must_exclude_zero": true,
      "max_control_regression_pp": 2,
      "max_nonexistent_symbol_rate_increase": 0,
      "max_tool_call_inflation_pct": 25
    }
  }
}
