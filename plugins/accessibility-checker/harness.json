{
  "profile": "json_tools",
  "coverage": {
    "module": "accessibility_checker",
    "search_paths": [
      "tools/accessibility-checker",
      "plugins/accessibility-checker"
    ],
    "fail_under": 80
  },
  "layers": {
    "l1": true,
    "l2": true,
    "l3_golden": true,
    "l4": true,
    "l5": true
  },
  "golden": {
    "fixtures": [
      "empty",
      "py-small"
    ],
    "queries": {
      "check_a11y_file": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "list_a11y_rules": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "a11y_summary": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "suggest_a11y_fixes": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      }
    }
  },
  "perf": {
    "enabled": false
  },
  "l4": {
    "smoke_args": {
      "root_path": "FIXTURE:empty",
      "query": "Greeter",
      "path": "README.md",
      "limit": 10,
      "depth": 3,
      "pattern": "Greeter",
      "text": "sample"
    },
    "expect_keys": {
      "check_a11y_file": [
        "ok",
        "violations",
        "count"
      ],
      "list_a11y_rules": [
        "items",
        "count"
      ],
      "a11y_summary": [
        "items",
        "count"
      ],
      "suggest_a11y_fixes": [
        "generated",
        "ok"
      ]
    },
    "invalid_tool": "check_a11y_file",
    "invalid_args": {},
    "post_timeout_tool": "check_a11y_file",
    "post_timeout_args": {
      "root_path": "FIXTURE:empty",
      "query": "x"
    }
  },
  "l5": {
    "treatment_plugins": [
      "accessibility-checker"
    ],
    "tool_names": [
      "check_a11y_file",
      "list_a11y_rules",
      "a11y_summary",
      "suggest_a11y_fixes"
    ],
    "gate": {
      "min_success_delta_pp": 10,
      "ci_must_exclude_zero": true,
      "max_control_regression_pp": 2,
      "max_nonexistent_symbol_rate_increase": 0,
      "max_tool_call_inflation_pct": 25
    }
  }
}
