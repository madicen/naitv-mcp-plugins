{
  "profile": "json_tools",
  "coverage": {
    "module": "deprecation_manager",
    "search_paths": [
      "tools/deprecation-manager",
      "plugins/deprecation-manager"
    ],
    "fail_under": 80
  },
  "layers": {
    "l1": true,
    "l2": true,
    "l3_golden": true,
    "l4": true,
    "l5": true
  },
  "golden": {
    "fixtures": [
      "empty",
      "py-small"
    ],
    "queries": {
      "find_deprecated": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "list_deprecations": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "check_deprecated_usage": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "plan_migration": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      }
    }
  },
  "perf": {
    "enabled": false
  },
  "l4": {
    "smoke_args": {
      "root_path": "FIXTURE:empty",
      "query": "Greeter",
      "path": "README.md",
      "limit": 10,
      "depth": 3,
      "pattern": "Greeter",
      "text": "sample"
    },
    "expect_keys": {
      "find_deprecated": [
        "items",
        "count"
      ],
      "list_deprecations": [
        "items",
        "count"
      ],
      "check_deprecated_usage": [
        "ok",
        "violations",
        "count"
      ],
      "plan_migration": [
        "generated",
        "ok"
      ]
    },
    "invalid_tool": "find_deprecated",
    "invalid_args": {},
    "post_timeout_tool": "find_deprecated",
    "post_timeout_args": {
      "root_path": "FIXTURE:empty",
      "query": "x"
    }
  },
  "l5": {
    "treatment_plugins": [
      "deprecation-manager"
    ],
    "tool_names": [
      "find_deprecated",
      "list_deprecations",
      "check_deprecated_usage",
      "plan_migration"
    ],
    "gate": {
      "min_success_delta_pp": 10,
      "ci_must_exclude_zero": true,
      "max_control_regression_pp": 2,
      "max_nonexistent_symbol_rate_increase": 0,
      "max_tool_call_inflation_pct": 25
    }
  }
}
