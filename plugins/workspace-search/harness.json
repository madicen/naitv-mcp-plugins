{
  "profile": "json_tools",
  "coverage": {
    "module": "workspace_search",
    "search_paths": [
      "tools/workspace-search",
      "plugins/workspace-search"
    ],
    "fail_under": 80
  },
  "layers": {
    "l1": true,
    "l2": true,
    "l3_golden": true,
    "l4": true,
    "l5": true
  },
  "golden": {
    "fixtures": [
      "py-small",
      "go-small",
      "empty"
    ],
    "queries": {
      "semantic_search": {
        "query": "Greeter",
        "limit": 5,
        "depth": 3
      },
      "text_search": {
        "pattern": "Greeter|greeter",
        "depth": 3
      },
      "rank_results": {
        "query": "Greeter",
        "candidates": [
          "pkg/greeter.py",
          "pkg/util/math.py",
          "README.md"
        ]
      }
    }
  },
  "perf": {
    "enabled": false
  },
  "l4": {
    "smoke_args": {
      "root_path": "FIXTURE:py-small",
      "query": "Greeter",
      "pattern": "Greeter",
      "limit": 5,
      "depth": 3,
      "candidates": [
        "pkg/greeter.py",
        "README.md"
      ]
    },
    "expect_keys": {
      "semantic_search": [
        "results",
        "count"
      ],
      "text_search": [
        "matches",
        "count"
      ],
      "rank_results": [
        "ranked",
        "count"
      ]
    },
    "invalid_tool": "semantic_search",
    "invalid_args": {},
    "post_timeout_tool": "rank_results",
    "post_timeout_args": {
      "query": "x",
      "candidates": [
        "a.py"
      ]
    }
  },
  "l5": {
    "treatment_plugins": [
      "workspace-search"
    ],
    "tool_names": [
      "semantic_search",
      "text_search",
      "rank_results"
    ],
    "gate": {
      "min_success_delta_pp": 10,
      "ci_must_exclude_zero": true,
      "max_control_regression_pp": 2,
      "max_nonexistent_symbol_rate_increase": 0,
      "max_tool_call_inflation_pct": 25
    },
    "model": {
      "name": "qwen3:8b",
      "provider": "ollama",
      "quantization": "default",
      "context": 8192,
      "temperature": 0,
      "seed": 0
    }
  }
}
