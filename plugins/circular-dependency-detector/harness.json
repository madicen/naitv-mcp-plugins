{
  "profile": "json_tools",
  "coverage": {
    "module": "circular_dependency_detector",
    "search_paths": [
      "tools/circular-dependency-detector",
      "plugins/circular-dependency-detector"
    ],
    "fail_under": 80
  },
  "layers": {
    "l1": true,
    "l2": true,
    "l3_golden": true,
    "l4": true,
    "l5": true
  },
  "golden": {
    "fixtures": [
      "empty",
      "py-small"
    ],
    "queries": {
      "find_cycles": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "cycle_path": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "suggest_break_points": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "check_change_cycles": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      }
    }
  },
  "perf": {
    "enabled": false
  },
  "l4": {
    "smoke_args": {
      "root_path": "FIXTURE:empty",
      "query": "Greeter",
      "path": "README.md",
      "limit": 10,
      "depth": 3,
      "pattern": "Greeter",
      "text": "sample"
    },
    "expect_keys": {
      "find_cycles": [
        "items",
        "count"
      ],
      "cycle_path": [
        "ok",
        "tool"
      ],
      "suggest_break_points": [
        "generated",
        "ok"
      ],
      "check_change_cycles": [
        "ok",
        "violations",
        "count"
      ]
    },
    "invalid_tool": "find_cycles",
    "invalid_args": {},
    "post_timeout_tool": "find_cycles",
    "post_timeout_args": {
      "root_path": "FIXTURE:empty",
      "query": "x"
    }
  },
  "l5": {
    "treatment_plugins": [
      "circular-dependency-detector"
    ],
    "tool_names": [
      "find_cycles",
      "cycle_path",
      "suggest_break_points",
      "check_change_cycles"
    ],
    "gate": {
      "min_success_delta_pp": 10,
      "ci_must_exclude_zero": true,
      "max_control_regression_pp": 2,
      "max_nonexistent_symbol_rate_increase": 0,
      "max_tool_call_inflation_pct": 25
    }
  }
}
