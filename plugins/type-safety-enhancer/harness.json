{
  "profile": "json_tools",
  "coverage": {
    "module": "type_safety_enhancer",
    "search_paths": [
      "tools/type-safety-enhancer",
      "plugins/type-safety-enhancer"
    ],
    "fail_under": 80
  },
  "layers": {
    "l1": true,
    "l2": true,
    "l3_golden": true,
    "l4": true,
    "l5": true
  },
  "golden": {
    "fixtures": [
      "empty",
      "py-small"
    ],
    "queries": {
      "infer_types": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "find_untyped_symbols": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "suggest_annotations": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "type_coverage_report": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      }
    }
  },
  "perf": {
    "enabled": false
  },
  "l4": {
    "smoke_args": {
      "root_path": "FIXTURE:empty",
      "query": "Greeter",
      "path": "README.md",
      "limit": 10,
      "depth": 3,
      "pattern": "Greeter",
      "text": "sample"
    },
    "expect_keys": {
      "infer_types": [
        "ok",
        "tool"
      ],
      "find_untyped_symbols": [
        "items",
        "count"
      ],
      "suggest_annotations": [
        "generated",
        "ok"
      ],
      "type_coverage_report": [
        "items",
        "count"
      ]
    },
    "invalid_tool": "infer_types",
    "invalid_args": {},
    "post_timeout_tool": "infer_types",
    "post_timeout_args": {
      "root_path": "FIXTURE:empty",
      "query": "x"
    }
  },
  "l5": {
    "treatment_plugins": [
      "type-safety-enhancer"
    ],
    "tool_names": [
      "infer_types",
      "find_untyped_symbols",
      "suggest_annotations",
      "type_coverage_report"
    ],
    "gate": {
      "min_success_delta_pp": 10,
      "ci_must_exclude_zero": true,
      "max_control_regression_pp": 2,
      "max_nonexistent_symbol_rate_increase": 0,
      "max_tool_call_inflation_pct": 25
    }
  }
}
