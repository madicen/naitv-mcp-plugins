{
  "profile": "json_tools",
  "coverage": {
    "module": "fuzzing_test_generator",
    "search_paths": [
      "tools/fuzzing-test-generator",
      "plugins/fuzzing-test-generator"
    ],
    "fail_under": 80
  },
  "layers": {
    "l1": true,
    "l2": true,
    "l3_golden": true,
    "l4": true,
    "l5": true
  },
  "golden": {
    "fixtures": [
      "empty",
      "py-small"
    ],
    "queries": {
      "find_fuzz_targets": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "generate_fuzz_target": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "validate_fuzz_target": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "run_fuzz_smoke": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      }
    }
  },
  "perf": {
    "enabled": false
  },
  "l4": {
    "smoke_args": {
      "root_path": "FIXTURE:empty",
      "query": "Greeter",
      "path": "README.md",
      "limit": 10,
      "depth": 3,
      "pattern": "Greeter",
      "text": "sample"
    },
    "expect_keys": {
      "find_fuzz_targets": [
        "items",
        "count"
      ],
      "generate_fuzz_target": [
        "generated",
        "ok"
      ],
      "validate_fuzz_target": [
        "ok",
        "violations",
        "count"
      ],
      "run_fuzz_smoke": [
        "ok",
        "exit_code",
        "summary"
      ]
    },
    "invalid_tool": "find_fuzz_targets",
    "invalid_args": {},
    "post_timeout_tool": "find_fuzz_targets",
    "post_timeout_args": {
      "root_path": "FIXTURE:empty",
      "query": "x"
    }
  },
  "l5": {
    "treatment_plugins": [
      "fuzzing-test-generator"
    ],
    "tool_names": [
      "find_fuzz_targets",
      "generate_fuzz_target",
      "validate_fuzz_target",
      "run_fuzz_smoke"
    ],
    "gate": {
      "min_success_delta_pp": 10,
      "ci_must_exclude_zero": true,
      "max_control_regression_pp": 2,
      "max_nonexistent_symbol_rate_increase": 0,
      "max_tool_call_inflation_pct": 25
    }
  }
}
