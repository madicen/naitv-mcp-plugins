{
  "profile": "json_tools",
  "coverage": {
    "module": "performance_regression_detector",
    "search_paths": [
      "tools/performance-regression-detector",
      "plugins/performance-regression-detector"
    ],
    "fail_under": 80
  },
  "layers": {
    "l1": true,
    "l2": true,
    "l3_golden": true,
    "l4": true,
    "l5": true
  },
  "golden": {
    "fixtures": [
      "empty",
      "py-small"
    ],
    "queries": {
      "load_baseline": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "compare_to_baseline": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "flag_regressions": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "update_baseline": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      }
    }
  },
  "perf": {
    "enabled": false
  },
  "l4": {
    "smoke_args": {
      "root_path": "FIXTURE:empty",
      "query": "Greeter",
      "path": "README.md",
      "limit": 10,
      "depth": 3,
      "pattern": "Greeter",
      "text": "sample"
    },
    "expect_keys": {
      "load_baseline": [
        "loaded",
        "content"
      ],
      "compare_to_baseline": [
        "ok",
        "tool"
      ],
      "flag_regressions": [
        "ok",
        "tool"
      ],
      "update_baseline": [
        "stored",
        "id"
      ]
    },
    "invalid_tool": "load_baseline",
    "invalid_args": {},
    "post_timeout_tool": "load_baseline",
    "post_timeout_args": {
      "root_path": "FIXTURE:empty",
      "query": "x"
    }
  },
  "l5": {
    "treatment_plugins": [
      "performance-regression-detector"
    ],
    "tool_names": [
      "load_baseline",
      "compare_to_baseline",
      "flag_regressions",
      "update_baseline"
    ],
    "gate": {
      "min_success_delta_pp": 10,
      "ci_must_exclude_zero": true,
      "max_control_regression_pp": 2,
      "max_nonexistent_symbol_rate_increase": 0,
      "max_tool_call_inflation_pct": 25
    }
  }
}
