{
  "profile": "json_tools",
  "coverage": {
    "module": "team_knowledge_extractor",
    "search_paths": [
      "tools/team-knowledge-extractor",
      "plugins/team-knowledge-extractor"
    ],
    "fail_under": 80
  },
  "layers": {
    "l1": true,
    "l2": true,
    "l3_golden": true,
    "l4": true,
    "l5": true
  },
  "golden": {
    "fixtures": [
      "empty",
      "py-small"
    ],
    "queries": {
      "mine_conventions": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "extract_ownership": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "extract_review_patterns": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "export_knowledge_base": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      }
    }
  },
  "perf": {
    "enabled": false
  },
  "l4": {
    "smoke_args": {
      "root_path": "FIXTURE:empty",
      "query": "Greeter",
      "path": "README.md",
      "limit": 10,
      "depth": 3,
      "pattern": "Greeter",
      "text": "sample"
    },
    "expect_keys": {
      "mine_conventions": [
        "items",
        "count"
      ],
      "extract_ownership": [
        "items",
        "count"
      ],
      "extract_review_patterns": [
        "items",
        "count"
      ],
      "export_knowledge_base": [
        "ok",
        "tool"
      ]
    },
    "invalid_tool": "mine_conventions",
    "invalid_args": {},
    "post_timeout_tool": "mine_conventions",
    "post_timeout_args": {
      "root_path": "FIXTURE:empty",
      "query": "x"
    }
  },
  "l5": {
    "treatment_plugins": [
      "team-knowledge-extractor"
    ],
    "tool_names": [
      "mine_conventions",
      "extract_ownership",
      "extract_review_patterns",
      "export_knowledge_base"
    ],
    "gate": {
      "min_success_delta_pp": 10,
      "ci_must_exclude_zero": true,
      "max_control_regression_pp": 2,
      "max_nonexistent_symbol_rate_increase": 0,
      "max_tool_call_inflation_pct": 25
    }
  }
}
