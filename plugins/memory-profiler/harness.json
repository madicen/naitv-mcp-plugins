{
  "profile": "json_tools",
  "coverage": {
    "module": "memory_profiler",
    "search_paths": [
      "tools/memory-profiler",
      "plugins/memory-profiler"
    ],
    "fail_under": 80
  },
  "layers": {
    "l1": true,
    "l2": true,
    "l3_golden": true,
    "l4": true,
    "l5": true
  },
  "golden": {
    "fixtures": [
      "empty",
      "py-small"
    ],
    "queries": {
      "run_memory_profile": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "parse_heap_profile": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "find_allocation_hotspots": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "memory_summary": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      }
    }
  },
  "perf": {
    "enabled": false
  },
  "l4": {
    "smoke_args": {
      "root_path": "FIXTURE:empty",
      "query": "Greeter",
      "path": "README.md",
      "limit": 10,
      "depth": 3,
      "pattern": "Greeter",
      "text": "sample"
    },
    "expect_keys": {
      "run_memory_profile": [
        "ok",
        "exit_code",
        "summary"
      ],
      "parse_heap_profile": [
        "loaded",
        "content"
      ],
      "find_allocation_hotspots": [
        "items",
        "count"
      ],
      "memory_summary": [
        "items",
        "count"
      ]
    },
    "invalid_tool": "run_memory_profile",
    "invalid_args": {},
    "post_timeout_tool": "run_memory_profile",
    "post_timeout_args": {
      "root_path": "FIXTURE:empty",
      "query": "x"
    }
  },
  "l5": {
    "treatment_plugins": [
      "memory-profiler"
    ],
    "tool_names": [
      "run_memory_profile",
      "parse_heap_profile",
      "find_allocation_hotspots",
      "memory_summary"
    ],
    "gate": {
      "min_success_delta_pp": 10,
      "ci_must_exclude_zero": true,
      "max_control_regression_pp": 2,
      "max_nonexistent_symbol_rate_increase": 0,
      "max_tool_call_inflation_pct": 25
    }
  }
}
