{
  "profile": "json_tools",
  "coverage": {
    "module": "integration_test_generator",
    "search_paths": [
      "tools/integration-test-generator",
      "plugins/integration-test-generator"
    ],
    "fail_under": 80
  },
  "layers": {
    "l1": true,
    "l2": true,
    "l3_golden": true,
    "l4": true,
    "l5": true
  },
  "golden": {
    "fixtures": [
      "empty",
      "py-small"
    ],
    "queries": {
      "find_integration_points": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "generate_integration_test": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "validate_test_file": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      },
      "list_fixtures": {
        "query": "Greeter",
        "path": "README.md",
        "limit": 10,
        "depth": 3
      }
    }
  },
  "perf": {
    "enabled": false
  },
  "l4": {
    "smoke_args": {
      "root_path": "FIXTURE:empty",
      "query": "Greeter",
      "path": "README.md",
      "limit": 10,
      "depth": 3,
      "pattern": "Greeter",
      "text": "sample"
    },
    "expect_keys": {
      "find_integration_points": [
        "items",
        "count"
      ],
      "generate_integration_test": [
        "generated",
        "ok"
      ],
      "validate_test_file": [
        "ok",
        "violations",
        "count"
      ],
      "list_fixtures": [
        "items",
        "count"
      ]
    },
    "invalid_tool": "find_integration_points",
    "invalid_args": {},
    "post_timeout_tool": "find_integration_points",
    "post_timeout_args": {
      "root_path": "FIXTURE:empty",
      "query": "x"
    }
  },
  "l5": {
    "treatment_plugins": [
      "integration-test-generator"
    ],
    "tool_names": [
      "find_integration_points",
      "generate_integration_test",
      "validate_test_file",
      "list_fixtures"
    ],
    "gate": {
      "min_success_delta_pp": 10,
      "ci_must_exclude_zero": true,
      "max_control_regression_pp": 2,
      "max_nonexistent_symbol_rate_increase": 0,
      "max_tool_call_inflation_pct": 25
    }
  }
}
